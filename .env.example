# ============================================================
# forager-faculty — 配置模板
# 复制为 .env 后填入真实值：cp .env.example .env
# ============================================================
# LLM 接入两种模式：
#
#   模式 A（默认）— 单 token 直连
#     只填下方 LLM_API_KEY / LLM_BASE_URL / LLM_MODEL 三项。
#     适用于 Anthropic / DeepSeek / 各类 OneAPI 兼容网关。
#
#   模式 B（可选）— token manager 动态多 token 池
#     将 token manager/tokens.example.json 复制为
#     token manager/tokens.json 并填入多个 key。
#     LLM 客户端检测到 tokens.json 存在时自动启用池模式：
#     配额探测 / 最少消耗优先 + 轮询分配 / 失效自动切换 / 用量统计。
#     模式 B 下仍建议保留 LLM_API_KEY 作为兜底。
# ============================================================

# ── LLM（模式 A：单 token）──
LLM_API_KEY=
LLM_BASE_URL=
# 模型名，例如 deepseek-chat / glm-4 / claude-sonnet-4 等，按你的网关支持填写
LLM_MODEL=

# ── LLM（模式 B：token manager 池模式附加项）──
# 池模式默认探测模型（填你网关上最便宜的可用模型）
TOKEN_PROBE_MODEL=
ONEPAI_BASE_URL=
# 每 token 并发信号量与全池并发上限
LLM_PER_TOKEN=2
LLM_CONCURRENCY_CAP=64
# 模型故障时的备选链（逗号分隔）
LLM_MODEL_FALLBACKS=
# 计价展示（元/百万 token，可选）
LLM_PRICE_IN=
LLM_PRICE_OUT=
LLM_BUDGET=

# ── LLM 调用与熔断 ──
LLM_TIMEOUT=120
LLM_SEM=
LLM_BREAKER_BASE=5

# ── 代理（默认关闭，直连）──
# PROXY_MODE=off 表示全直连；=on 时走 PROXY_URL 隧道
PROXY_MODE=off
# 隧道地址，格式 user:pass@host:port（也可仅 host:port）
PROXY_URL=
# 直连失败/代理慢速的切换阈值
DIRECT_TIMEOUT=15
DIRECT_FAIL_LIMIT=2
PROXY_SLOW_LIMIT=3
PROXY_SLOW_THRESHOLD=8

# ── 快代理 kdlapi（可选，隧道代理）──
KDL_TUNNEL_USER=
KDL_TUNNEL_PASSWORD=
KDL_TUNNEL_HOST=
KDL_SECRET_ID=
KDL_SIGNATURE=

# ── 快代理 dps 独享代理（可选）──
DPS_API_URL=
DPS_USER=
DPS_PWD=

# ── 浏览器渲染层总开关 ──
# off（默认）= 纯 CPU 请求链（curl_cffi/系统curl/iv8/nodenv/sdenv），跳过页面渲染层
#              （DrissionPage 池 / CDP / CloakBrowser）；9333 常驻 Cookie 工厂不受影响
# on         = 启用浏览器渲染兜底层（小内存机器慎用，详见 docs/瑞数反爬解决方案.md）
# ⚠️ 不要留空：显式空值会被解析为 on
BROWSER_TIERS=off

# ── 浏览器池（DrissionPage 渲染兜底，BROWSER_TIERS=on 时生效）──
DRISSION_MAX_WINDOWS=3
DRISSION_MAX_TABS_PER_WINDOW=4
DRISSION_PORT_BASE=9340
DRISSION_EXTRA_BROWSERS=
BROWSER_IDLE_REAP=180

# ── CDP 常驻浏览器（Playwright 复用通道）──
CDP_BASE_URL=http://127.0.0.1:9222
PROJECT_CHROME_BIN=

# ── 反爬 cookie 缓存 TTL ──
IV8_COOKIE_TTL=
IV8_UA=
RS_COOKIE_TTL=
RS_DISABLE=
NODENV_SKIP_TTL=

# ── 资源守卫（三档负载保护）──
RESOURCE_GUARD=
RG_CPU_RED=
RG_CPU_YELLOW=
RG_MEM_RED=
RG_MEM_YELLOW=

# ── 采集流水线 ──
DOWNLOAD_PDF=1
RATE_LIMIT=0.3
SPIDER_TIMEOUT=900
SPIDER_STALL_MINUTES=15
RESUME=1
TEACHER_WORKERS=4
AGENT_WORKERS=4
RETRY_MAX=3
RETRY_BACKOFF=2
AUTO_BACKFILL=1
SEARCH_RESCUE_MAX=10
REEXTRACT_LLM=1
EXTRACT_MIN_SAMPLES=
SLOW_DEPT_THRESHOLD=

# ── 外部 llm_client 兜底路径（一般无需填写；util/llm_client.py 缺失时才生效）──
PAPER_DAILY_ROOT=
